---
interface Props {
  currentSection: string;
  pageTitle: string;
}
const { currentSection, pageTitle } = Astro.props;

import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';

const subSections = [
  { label: '환영합니다', href: '/about' },
  { label: '역사',       href: '/about/history'  },
  { label: '담임 목사',  href: '/about/pastor'   },
];
---

<Layout title={`${pageTitle} | 시애틀 참빛교회`}>
  <Navbar />

  <main class="bg-white flex-1 pt-20">
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-24 xl:py-32">
      <div class="grid md:grid-cols-[1fr_220px] gap-12 md:gap-16 items-start">

        <!-- Article -->
        <article>
          <h1 class="text-3xl md:text-4xl font-bold text-gray-900 pb-2 mb-10">
            <span class="px-1 -mx-1 bg-[linear-gradient(transparent_62%,rgba(240,194,45,0.35)_62%)]">
              {currentSection}
            </span>
          </h1>
          <div class="font-serif text-[17px] md:text-[20px] text-gray-600 leading-relaxed space-y-6">
            <slot />
          </div>
        </article>

        <!-- Sidebar -->
        <aside class="sticky top-28">
          <nav class="flex flex-col gap-1">
            {subSections.map(section => {
              const isActive = section.label === currentSection;
              return (
                <a
                  href={section.href}
                  class:list={[
                    'group flex items-center gap-2 px-4 py-2.5 text-[18px] transition-colors',
                    isActive
                      ? 'bg-gray-100 text-gray-900 font-semibold'
                      : 'text-gray-400 hover:text-gray-900 hover:bg-gray-50',
                  ]}
                >
                  <svg
                    class:list={[
                      'w-4 h-4 shrink-0 transition-opacity',
                      isActive ? 'opacity-100' : 'opacity-0 group-hover:opacity-40',
                    ]}
                    fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6" />
                  </svg>
                  {section.label}
                </a>
              );
            })}
          </nav>
        </aside>

      </div>
    </div>
  </main>

  <Footer />
</Layout>
