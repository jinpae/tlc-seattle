---
import { client } from '../lib/sanity';

const schedule = [
  { name: '주일 예배 (본당)',       time: '주일 오후 1:15'   },
  { name: '새벽 예배 (Zoom)',       time: '화~금 오전 6:30' },
  { name: '수요 성경공부 (Zoom)',   time: '수 저녁 7:30'    },
  { name: '소그룹 모임',           time: '주중'            },
];

const newsItems: { title: string; slug: string; date: string }[] = await client.fetch(
  `*[_type == "news"] | order(date desc) [0...5] { title, "slug": slug.current, date }`
);
---

<section class="bg-white py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16">

      <!-- 예배 & 모임 안내 -->
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-gray-200">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">예배 & 모임 안내</h2>
          <a href="/worship" class="text-gray-600 hover:text-gray-900 transition-colors" aria-label="예배 안내 전체 보기">
            <svg class="plus-icon w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </a>
        </div>
        <div class="divide-y divide-gray-200 border-b border-gray-200">
          {schedule.map(item => (
            <div class="flex items-center justify-between py-4">
              <span class="text-gray-600 text-[20px]">{item.name}</span>
              <span class="text-gray-500 text-[20px] font-light tabular-nums">{item.time}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- 교회 소식 -->
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-gray-200">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900">교회 소식</h2>
          <a href="/news" class="text-gray-600 hover:text-gray-900 transition-colors" aria-label="교회 소식 전체 보기">
            <svg class="plus-icon w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </a>
        </div>
        <div class="divide-y divide-gray-200 border-b border-gray-200">
          {newsItems.length === 0 ? (
            <p class="text-gray-400 text-[20px] py-4">등록된 소식이 없습니다.</p>
          ) : (
            newsItems.map(item => (
              <a href={`/news/${item.slug}`} class="flex items-center justify-between py-4 group">
                <span class="text-gray-600 text-[20px] group-hover:text-gray-900 transition-colors truncate pr-4">{item.title}</span>
                <span class="text-gray-500 text-[20px] font-light tabular-nums shrink-0">{item.date}</span>
              </a>
            ))
          )}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .plus-icon { stroke-width: 1; }
  @media (min-resolution: 2dppx) {
    .plus-icon { stroke-width: 0.6; }
  }
</style>
