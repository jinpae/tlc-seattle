---
interface Props {
  variant?: 'hero' | 'page';
}
const { variant = 'page' } = Astro.props;

const navLinks = [
  { label: '교회 소개', href: '/about' },
  { label: '예배 및 모임', href: '/worship' },
  { label: '설교', href: '/sermons' },
  { label: '사진첩', href: '/gallery' },
  { label: '오시는 길', href: '/directions' },
];
---

<header
  id="navbar"
  data-variant={variant}
  class:list={[
    'fixed top-0 left-0 right-0 z-50 border-b transition-[background-color,border-color,box-shadow] duration-300',
    variant === 'page'
      ? 'bg-white/95 backdrop-blur-sm border-gray-100 shadow-md'
      : 'bg-[#f7f5f2] border-transparent',
  ]}
>
  <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" aria-label="시애틀 참빛교회 홈">
      <img src="/images/logo.svg" alt="시애틀 참빛교회 로고" class="h-[40px] w-auto" />
    </a>

    <!-- Desktop nav links -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="text-[1.125rem] 3xl:text-[1.25rem] tracking-[-0.04rem] text-gray-600 hover:text-gray-900 transition-colors font-bold"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Mobile toggle button -->
    <button
      id="menu-toggle"
      class="md:hidden p-2 text-gray-600"
      aria-label="메뉴 열기"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<!-- Backdrop -->
<div
  id="mobile-backdrop"
  class="mobile-backdrop fixed inset-0 bg-black/40 z-[55] md:hidden"
  aria-hidden="true"
></div>

<!-- Drawer (slides in from right) -->
<nav
  id="mobile-menu"
  class="mobile-drawer fixed top-0 right-0 h-[100dvh] w-72 bg-white z-[60] pointer-events-none md:hidden shadow-xl"
  style="display:none"
  aria-hidden="true"
>
  <div class="flex items-center justify-end px-4 h-20">
    <button id="drawer-close" class="p-2 text-gray-600" aria-label="메뉴 닫기">
      <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <div class="flex flex-col divide-y divide-gray-100 px-6">
    {navLinks.map(link => (
      <a
        href={link.href}
        class="text-xl font-bold text-gray-700 hover:text-gray-900 transition-colors py-4"
      >
        {link.label}
      </a>
    ))}
  </div>
</nav>

<script>
  function updateNavbar() {
    const navbar = document.getElementById('navbar');
    if (navbar?.dataset.variant !== 'hero') return;

    const scrolled = window.scrollY > 0;
    navbar.classList.toggle('bg-white/95', scrolled);
    navbar.classList.toggle('bg-[#f7f5f2]', !scrolled);
    navbar.classList.toggle('backdrop-blur-sm', scrolled);
    navbar.classList.toggle('border-gray-100', scrolled);
    navbar.classList.toggle('border-transparent', !scrolled);
    navbar.classList.toggle('shadow-md', scrolled);
  }

  function initMobileMenu() {
    const toggle = document.getElementById('menu-toggle');
    if (!toggle || toggle.dataset.menuInit) return;
    toggle.dataset.menuInit = '1';

    const backdrop = document.getElementById('mobile-backdrop');
    const menu = document.getElementById('mobile-menu');
    const drawerClose = document.getElementById('drawer-close');
    if (!backdrop || !menu) return;

    menu.addEventListener('transitionend', (e) => {
      if (e.propertyName === 'transform' && !menu.classList.contains('open')) {
        menu.style.display = 'none';
      }
    });

    function openMenu() {
      menu.style.display = '';
      menu.offsetWidth; // flush pending styles so transition fires from initial state
      backdrop.classList.add('open');
      menu.classList.add('open');
      menu.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', '메뉴 닫기');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      backdrop.classList.remove('open');
      menu.classList.remove('open');
      menu.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '메뉴 열기');
      document.body.style.overflow = '';
    }

    toggle.addEventListener('click', () => {
      toggle.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
    });
    drawerClose?.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });
  }

  updateNavbar();
  initMobileMenu();
  document.addEventListener('astro:page-load', () => { updateNavbar(); initMobileMenu(); });
  window.addEventListener('scroll', updateNavbar, { passive: true });
</script>

<style>
  .mobile-backdrop {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.19s 0.16s cubic-bezier(0.5, 0, 1, 1),
      visibility 0s 0.35s linear;
  }
  .mobile-backdrop.open {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.3s 0s cubic-bezier(0, 0, 0.4, 1);
  }

  .mobile-drawer {
    transform: translateX(100%);
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 350ms cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s 350ms linear;
  }
  .mobile-drawer.open {
    transform: translateX(0);
    visibility: visible;
    pointer-events: auto;
    transition:
      transform 350ms cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s 0s linear;
  }
</style>
