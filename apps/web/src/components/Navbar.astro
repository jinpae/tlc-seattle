---
interface Props {
  variant?: 'hero' | 'page';
}
const { variant = 'page' } = Astro.props;

const navLinks = [
  { label: '교회 소개', href: '/about' },
  { label: '예배 및 모임', href: '/worship' },
  { label: '설교', href: '/sermons' },
  { label: '사진첩', href: '/gallery' },
  { label: '오시는 길', href: '/directions' },
];
---

<header
  id="navbar"
  data-variant={variant}
  class:list={[
    'fixed top-0 left-0 right-0 z-50 border-b transition-[background-color,border-color,box-shadow] duration-300',
    variant === 'page'
      ? 'bg-white/95 backdrop-blur-sm border-gray-100 shadow-md'
      : 'bg-[#f7f5f2] border-transparent',
  ]}
>
  <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" aria-label="시애틀 참빛교회 홈">
      <img src="/images/logo.svg" alt="시애틀 참빛교회 로고" class="h-[40px] w-auto" />
    </a>

    <!-- Desktop nav links -->
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="text-[1.125rem] 3xl:text-[1.25rem] tracking-[-0.04rem] text-gray-600 hover:text-gray-900 transition-colors font-bold"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Mobile toggle button -->
    <button
      id="menu-toggle"
      class="md:hidden p-2 text-gray-600"
      aria-label="메뉴 열기"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="w-9 h-9 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</header>

<!-- Backdrop (below navbar) -->
<div
  id="mobile-backdrop"
  class="fixed top-20 inset-x-0 bottom-0 bg-black/40 z-40 hidden md:hidden"
  aria-hidden="true"
></div>

<!-- Clip wrapper: overflow-hidden creates the slide-from-top effect -->
<div id="mobile-clip" class="fixed top-20 left-0 right-0 z-40 overflow-hidden pointer-events-none md:hidden">
  <nav
    id="mobile-menu"
    class="-translate-y-full pointer-events-none transition-transform duration-300 ease-in-out bg-white"
    aria-hidden="true"
  >
    <div class="flex flex-col divide-y divide-gray-100 px-6 py-2">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="text-xl font-bold text-gray-700 hover:text-gray-900 transition-colors py-4"
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</div>

<script>
  function updateNavbar() {
    const navbar = document.getElementById('navbar');
    if (navbar?.dataset.variant !== 'hero') return;

    const scrolled = window.scrollY > 0;
    navbar.classList.toggle('bg-white/95', scrolled);
    navbar.classList.toggle('bg-[#f7f5f2]', !scrolled);
    navbar.classList.toggle('backdrop-blur-sm', scrolled);
    navbar.classList.toggle('border-gray-100', scrolled);
    navbar.classList.toggle('border-transparent', !scrolled);
    navbar.classList.toggle('shadow-md', scrolled);
  }

  function initMobileMenu() {
    const toggle = document.getElementById('menu-toggle');
    if (!toggle || toggle.dataset.menuInit) return;
    toggle.dataset.menuInit = '1';

    const backdrop = document.getElementById('mobile-backdrop');
    const clip = document.getElementById('mobile-clip');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    if (!backdrop || !clip || !menu || !iconOpen || !iconClose) return;

    function openMenu() {
      backdrop.classList.remove('hidden');
      clip.classList.remove('pointer-events-none');
      menu.classList.remove('-translate-y-full', 'pointer-events-none');
      menu.classList.add('shadow-lg');
      menu.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', '메뉴 닫기');
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      backdrop.classList.add('hidden');
      clip.classList.add('pointer-events-none');
      menu.classList.add('-translate-y-full', 'pointer-events-none');
      menu.classList.remove('shadow-lg');
      menu.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '메뉴 열기');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      document.body.style.overflow = '';
    }

    toggle.addEventListener('click', () => {
      toggle.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
    });
    backdrop.addEventListener('click', closeMenu);
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMenu(); });
  }

  updateNavbar();
  initMobileMenu();
  document.addEventListener('astro:page-load', () => { updateNavbar(); initMobileMenu(); });
  window.addEventListener('scroll', updateNavbar, { passive: true });
</script>
