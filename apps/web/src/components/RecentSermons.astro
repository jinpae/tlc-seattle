---
const sermons = [
  {
    title: '참 빛 되신 예수님을 전하는 삶',
    scripture: '요한복음 1:1-9',
    date: '06.08.2026',
    slug: '06-08-2026',
  },
  {
    title: '하나님의 은혜로 충분합니다',
    scripture: '고린도후서 12:9-10',
    date: '06.01.2026',
    slug: '06-01-2026',
  },
  {
    title: '믿음으로 나아가라',
    scripture: '히브리서 11:1-6',
    date: '05.25.2026',
    slug: '05-25-2026',
  },
  {
    title: '성령 안에서 하나 되는 공동체',
    scripture: '에베소서 4:1-6',
    date: '05.18.2026',
    slug: '05-18-2026',
  },
  {
    title: '주님의 뜻대로 살아가기',
    scripture: '로마서 12:1-2',
    date: '05.11.2026',
    slug: '05-11-2026',
  },
  {
    title: '예배하는 삶',
    scripture: '시편 100:1-5',
    date: '05.04.2026',
    slug: '05-04-2026',
  },
];
---

<section class="bg-[#f1f1f1] py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-[#352F2D]">최근 설교</h2>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sermons.map(sermon => (
        <a
          href={`/sermons/${sermon.slug}`}
          class="group bg-white overflow-hidden"
        >
          <!-- Thumbnail placeholder -->
          <div class="aspect-video overflow-hidden">
            <div class="w-full h-full bg-[#352F2D]/80 scale-100 group-hover:scale-105 transition-transform duration-300" />
          </div>

          <!-- Content -->
          <div class="p-5">
            <h3 class="font-bold text-[#352F2D] text-[20px] leading-snug mb-3">
              {sermon.title}
            </h3>
            <p class="flex items-center gap-1.5 text-sm text-gray-500 mb-1.5">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.5C12 6.5 9.5 5 6 5c-1.5 0-3 .5-3 .5v14s1.5-.5 3-.5c3.5 0 6 1.5 6 1.5s2.5-1.5 6-1.5c1.5 0 3 .5 3 .5v-14s-1.5-.5-3-.5c-3.5 0-6 1.5-6 1.5ZM12 6.5V20.5" />
              </svg>
              {sermon.scripture}
            </p>
            <p class="flex items-center gap-1.5 text-sm text-gray-500">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 2v4M8 2v4M3 10h18" />
              </svg>
              {sermon.date}
            </p>
          </div>
        </a>
      ))}
    </div>

    <!-- View all -->
    <div class="text-center mt-12">
      <a
        href="/sermons"
        class="inline-flex items-center gap-2 text-[#352F2D] font-semibold text-lg 3xl:text-xl border border-[#352F2D]/40 px-[28px] py-[14px] 3xl:px-[32px] 3xl:py-[16px] rounded-lg hover:bg-[#352F2D]/10 transition-colors"
      >
        전체 설교 보기
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

  </div>
</section>
