---
---

<section class="bg-[#f1f1f1] py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-6">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-[#352F2D]">최근 설교</h2>
    </div>

    <div id="recent-sermons-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {Array.from({ length: 6 }).map(() => (
        <div class="bg-white overflow-hidden shadow-sm animate-pulse flex flex-col">
          <div class="aspect-video bg-[#352F2D]/10" />
          <div class="sermon-card-body">
            <div class="h-[22px] bg-gray-200 rounded w-4/5" />
            <div class="h-[22px] bg-gray-200 rounded w-3/5 mt-3" />
            <div class="h-4 bg-gray-100 rounded w-2/5 mt-4" />
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <a
        href="/sermons"
        class="inline-flex items-center gap-2 text-[#352F2D] font-semibold text-lg border border-[#352F2D]/40 px-[28px] py-[14px] rounded-lg hover:bg-[#352F2D]/10 transition-colors"
      >
        설교 더 보기
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

  </div>
</section>


<script is:inline>
  async function loadSermons() {
    let sermons;
    try {
      const res = await fetch('/api/sermons.json');
      if (!res.ok) throw new Error(res.status);
      ({ sermons } = await res.json());
    } catch {
      return;
    }

    const grid = document.getElementById('recent-sermons-grid');
    if (!grid) return;

    grid.innerHTML = sermons.map(({ videoId, title, publishedAt, thumbnail, duration }) => {
      const date = new Date(publishedAt).toLocaleDateString('ko-KR', {
        year: 'numeric', month: 'long', day: 'numeric',
      });
      return `
        <a href="/sermons/${videoId}"
           class="sermon-card group bg-white overflow-hidden">
          <div class="relative aspect-video overflow-hidden">
            <img
              src="${thumbnail}"
              alt="${title.replace(/"/g, '&quot;')}"
              class="w-full h-full object-cover"
              loading="lazy"
            />
            ${duration ? `<span class="absolute bottom-2 right-2 bg-black/80 text-white text-xs font-medium px-1.5 py-0.5 rounded">${duration}</span>` : ''}
          </div>
          <div class="sermon-card-body">
            <h3 class="font-bold text-[#352F2D] text-[20px] leading-snug mb-3 line-clamp-2">
              ${title}
            </h3>
            <p class="flex items-center gap-1.5 text-sm text-gray-500">
              <svg width="16" height="16" style="flex-shrink:0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 2v4M8 2v4M3 10h18" />
              </svg>
              ${date}
            </p>
          </div>
        </a>`;
    }).join('');
  }

  document.addEventListener('astro:page-load', loadSermons);
</script>
