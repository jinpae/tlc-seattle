---
import { PUBLIC_YOUTUBE_API_KEY } from 'astro:env/client';
const CHANNEL_ID = 'UCgneXaRspkl-5lwShOP0ElQ';
const PLAYLIST_ID = 'UU' + CHANNEL_ID.slice(2);
---

<section class="bg-[#f1f1f1] py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-6">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-[#352F2D]">최근 설교</h2>
    </div>

    <div id="sermons-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {Array.from({ length: 6 }).map(() => (
        <div class="bg-white rounded-lg overflow-hidden shadow-sm animate-pulse">
          <div class="aspect-video bg-[#352F2D]/10" />
          <div class="p-5 space-y-3">
            <div class="h-5 bg-gray-200 rounded w-4/5" />
            <div class="h-5 bg-gray-200 rounded w-3/5" />
            <div class="h-4 bg-gray-100 rounded w-2/5 mt-4" />
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <a
        href="https://www.youtube.com/@truelightchurchinseattle8336"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-[#352F2D] font-semibold text-lg border border-[#352F2D]/40 px-[28px] py-[14px] rounded-lg hover:bg-[#352F2D]/10 transition-colors"
      >
        전체 설교 보기
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

  </div>
</section>

<style is:global>
  .sermon-card {
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.08);
    transition: box-shadow 0.2s ease;
  }
  .sermon-card:hover {
    box-shadow: 0 0.1875rem 0.4375rem 0 rgba(0, 0, 0, 0.13), 0 0.0625rem 0.125rem 0 rgba(0, 0, 0, 0.11);
  }
</style>

<script define:vars={{ PLAYLIST_ID, PUBLIC_YOUTUBE_API_KEY }}>
  function parseDuration(iso) {
    const match = iso.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
    if (!match) return '';
    const h = parseInt(match[1] || 0);
    const m = parseInt(match[2] || 0);
    const s = parseInt(match[3] || 0);
    if (h > 0) return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    return `${m}:${String(s).padStart(2, '0')}`;
  }

  async function loadSermons() {
    const key = PUBLIC_YOUTUBE_API_KEY;

    let items;
    try {
      const res = await fetch(`https://www.googleapis.com/youtube/v3/playlistItems?part=snippet&playlistId=${PLAYLIST_ID}&maxResults=6&key=${key}`);
      if (!res.ok) throw new Error(res.status);
      ({ items } = await res.json());
    } catch {
      return;
    }

    const grid = document.getElementById('sermons-grid');
    if (!grid) return;

    // Render cards immediately — duration badges start hidden
    grid.innerHTML = items.map(({ snippet }) => {
      const videoId = snippet.resourceId.videoId;
      const title = snippet.title;
      const date = new Date(snippet.publishedAt).toLocaleDateString('ko-KR', {
        year: 'numeric', month: 'long', day: 'numeric',
      });
      const thumb = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
      const href = `https://www.youtube.com/watch?v=${videoId}`;

      return `
        <a href="${href}" target="_blank" rel="noopener noreferrer"
           class="sermon-card group bg-white rounded-lg overflow-hidden">
          <div class="relative aspect-video overflow-hidden">
            <img
              src="${thumb}"
              alt="${title.replace(/"/g, '&quot;')}"
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <span data-duration="${videoId}" class="hidden absolute bottom-2 right-2 bg-black/80 text-white text-xs font-medium px-1.5 py-0.5 rounded"></span>
          </div>
          <div class="p-5">
            <h3 class="font-bold text-[#352F2D] text-[20px] leading-snug mb-3 line-clamp-2">
              ${title}
            </h3>
            <p class="flex items-center gap-1.5 text-sm text-gray-500">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 2v4M8 2v4M3 10h18" />
              </svg>
              ${date}
            </p>
          </div>
        </a>`;
    }).join('');

    // Patch in durations without blocking card rendering
    const videoIds = items.map(({ snippet }) => snippet.resourceId.videoId).join(',');
    try {
      const res = await fetch(`https://www.googleapis.com/youtube/v3/videos?part=contentDetails,snippet&id=${videoIds}&key=${key}`);
      if (!res.ok) return;
      const { items: details } = await res.json();
      details.forEach(d => {
        const badge = grid.querySelector(`[data-duration="${d.id}"]`);
        if (!badge) return;
        const label = d.snippet.liveBroadcastContent === 'upcoming'
          ? 'Upcoming'
          : parseDuration(d.contentDetails.duration);
        if (label) {
          badge.textContent = label;
          badge.classList.remove('hidden');
        }
      });
    } catch {
      // silently skip — cards are already rendered
    }
  }

  document.addEventListener('astro:page-load', loadSermons);
</script>
