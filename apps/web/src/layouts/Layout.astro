---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = '시애틀 참빛교회' } = Astro.props;
---

<!doctype html>
<html lang="ko" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preload" href="/fonts/PretendardVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IropkeBatangM.woff" as="font" type="font/woff" crossorigin />
    <ClientRouter />
    <script>
      // The router swaps the whole <body>, destroying the focused link and
      // silently resetting focus to <body>. Restore focus to the equivalent
      // link in the new DOM so the next Tab resumes from there, for keyboard
      // and mouse alike (browsers keep the focus ring keyboard-only). Match by
      // href + occurrence index since the same href can appear in both the
      // navbar and a sub-menu.
      let focused: { href: string; index: number } | null = null;

      document.addEventListener('astro:before-swap', () => {
        focused = null;
        const el = document.activeElement;
        if (el instanceof HTMLAnchorElement) {
          const href = el.getAttribute('href');
          if (href) {
            const sameHref = document.querySelectorAll(`a[href="${href}"]`);
            focused = { href, index: [...sameHref].indexOf(el) };
          }
        }
      });

      document.addEventListener('astro:after-swap', () => {
        if (!focused) return;
        const sameHref = document.querySelectorAll(`a[href="${focused.href}"]`);
        const target = sameHref[focused.index] ?? sameHref[0];
        if (target instanceof HTMLElement) target.focus({ preventScroll: true });
        focused = null;
      });
    </script>
  </head>
  <body class="bg-white text-gray-900 antialiased min-h-screen flex flex-col">
    <slot />
  </body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
  }
</style>
