---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import locationImg from '../assets/location.webp';
import { church } from '../lib/config';

const mapsDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${church.street}, ${church.cityStateZip}`)}`;
---

<Layout title="오시는 길 | 시애틀 참빛교회" description="시애틀 참빛교회 주소와 위치, 오시는 길을 확인하실 수 있습니다.">
  <Navbar />

  <main class="bg-white flex-1 pt-20">
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-24 xl:py-32">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 pb-2 mb-10">
        <span class="px-1 -mx-1 bg-[linear-gradient(transparent_62%,rgba(240,194,45,0.35)_62%)]">
          오시는 길
        </span>
      </h1>

      <div class="mb-10 overflow-hidden">
        <Image
          src={locationImg}
          alt="Evergreen Baptist Church — 시애틀 참빛교회 예배 장소"
          class="w-full object-cover pointer-events-none select-none"
          loading="eager"
          draggable="false"
        />
      </div>

      <div>
        <h2 class="text-[17px] md:text-[20px] font-bold text-gray-700 mb-3">주소</h2>
        <p class="text-[17px] md:text-[20px] text-gray-700 leading-relaxed">
          {church.street}<br />
          {church.cityStateZip}<br />
          <a href={`tel:${church.phoneTel}`} class="hover:text-gray-900 transition-colors">{church.phone}</a>
        </p>

        <a
          href={mapsDirectionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 mt-6 text-[17px] md:text-[20px] text-gray-500 hover:text-gray-900 transition-colors"
        >
          구글맵에서 열기
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
