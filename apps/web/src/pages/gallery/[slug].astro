---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PhotoGrid from '../../components/PhotoGrid';
import { client } from '../../lib/sanity';
import { albumBySlugQuery, type AlbumDetail } from '../../lib/queries/gallery';

const { slug } = Astro.params;
const album: AlbumDetail | null = await client.fetch(albumBySlugQuery, { slug });

if (!album) {
  return Astro.redirect('/gallery');
}

const date = new Date(album.date).toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const photos = (album.photos ?? []).map(p => ({
  id: p._id,
  url: p.url,
  width: p.metadata.dimensions.width,
  height: p.metadata.dimensions.height,
}));
---

<Layout title={`${album.title} | 시애틀 참빛교회`}>
  <Navbar />

  <main class="bg-white flex-1 pt-20">
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-24 xl:py-32">

      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 pb-4 border-b border-gray-200 mb-10">
        <span class="px-1 -mx-1 bg-[linear-gradient(transparent_62%,rgba(240,194,45,0.35)_62%)]">
          사진첩
        </span>
      </h1>

      <div>
        <h2 class="text-xl md:text-2xl font-bold text-gray-900 leading-snug mb-2">
          {album.title}
        </h2>
        <p class="flex items-center gap-1.5 text-sm text-gray-500 mb-6">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 2v4M8 2v4M3 10h18" />
          </svg>
          {date}
          {photos.length > 0 && (
            <>
              <span class="text-gray-300">·</span>
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>{photos.length}장</span>
            </>
          )}
        </p>
        {album.description && (
          <p class="text-lg text-gray-500 mb-8">{album.description}</p>
        )}

        {photos.length === 0 ? (
          <p class="text-center text-gray-400 py-24">사진이 없습니다.</p>
        ) : (
          <PhotoGrid photos={photos} client:load />
        )}

        <a
          href="/gallery"
          class="inline-flex items-center gap-1.5 text-[18px] text-gray-500 hover:text-gray-900 transition-colors mt-16"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          앨범 목록
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
