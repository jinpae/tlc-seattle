---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { client } from '../../lib/sanity';
import { albumsQuery, type AlbumSummary } from '../../lib/queries/gallery';

const albums: AlbumSummary[] = await client.fetch(albumsQuery);
---

<Layout title="사진첩 | 시애틀 참빛교회">
  <Navbar />

  <main class="bg-white flex-1 pt-20">
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-24 xl:py-32">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 pb-2 mb-10">
        <span class="px-1 -mx-1 bg-[linear-gradient(transparent_62%,rgba(240,194,45,0.35)_62%)]">
          사진첩
        </span>
      </h1>

      {albums.length === 0 ? (
        <p class="text-center text-gray-400 py-24">사진첩이 없습니다.</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {albums.map(album => {
            const date = new Date(album.date).toLocaleDateString('ko-KR', {
              year: 'numeric', month: 'long', day: 'numeric',
            });
            const thumbUrl = album.coverImage
              ? `${album.coverImage.url}?w=600&h=450&fit=crop&auto=format&q=80`
              : null;

            return (
              <a
                href={`/gallery/${album.slug.current}`}
                class="group block overflow-hidden border border-gray-200 hover:border-gray-300 transition-colors"
              >
                <div class="aspect-[4/3] bg-gray-100 overflow-hidden">
                  {thumbUrl ? (
                    <img
                      src={thumbUrl}
                      alt={album.title}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-107"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-gray-300">
                      <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                  )}
                </div>
                <div class="p-4">
                  <h2 class="font-bold text-gray-900 text-lg leading-snug group-hover:text-gray-600 transition-colors">
                    {album.title}
                  </h2>
                  <p class="text-sm text-gray-400 mt-1 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <rect x="3" y="4" width="18" height="18" rx="2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 2v4M8 2v4M3 10h18" />
                    </svg>
                    {date}
                    {album.photoCount > 0 && (
                      <span class="text-gray-300">·</span>
                      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      <span>{album.photoCount}장</span>
                    )}
                  </p>
                  {album.description && (
                    <p class="text-sm text-gray-500 mt-2 line-clamp-2">{album.description}</p>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>
