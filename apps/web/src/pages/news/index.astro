---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { client } from '../../lib/sanity';
import { newsPaginatedQuery, type NewsItem } from '../../lib/queries/news';

const PAGE_SIZE = 10;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1'));
const from = (page - 1) * PAGE_SIZE;
const to = from + PAGE_SIZE;

const { items, total }: { items: NewsItem[]; total: number } =
  await client.fetch(newsPaginatedQuery, { from, to });

const hasPrev = page > 1;
const hasNext = to < total;
---

<Layout title="교회 소식 | 시애틀 참빛교회">
  <Navbar />

  <main class="bg-white flex-1 pt-20">
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-24 xl:py-32">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 pb-2 mb-10">
        <span class="px-1 -mx-1 bg-[linear-gradient(transparent_62%,rgba(240,194,45,0.35)_62%)]">
          알려드립니다
        </span>
      </h1>

      {items.length === 0 ? (
        <p class="text-center text-gray-400 py-24">등록된 소식이 없습니다.</p>
      ) : (
        <>
          <ul class="border-t border-gray-200">
            {items.map(item => (
              <li class="border-b border-gray-200">
                <a
                  href={`/news/${item.slug.current}`}
                  class="flex items-baseline justify-between gap-6 px-6 py-5 md:py-6 hover:bg-gray-50"
                >
                  <p class="text-[17px] md:text-[20px] font-semibold text-gray-900 leading-snug">
                    {item.title}
                  </p>
                  <p class="text-[17px] md:text-[20px] text-gray-400 shrink-0">{item.date}</p>
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-10 flex items-center justify-end gap-6">
            {hasPrev && (
              <a
                href={`/news?page=${page - 1}`}
                class="inline-flex items-center gap-1.5 text-[18px] text-gray-500 hover:text-gray-900 transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                이전
              </a>
            )}
            {hasNext && (
              <a
                href={`/news?page=${page + 1}`}
                class="inline-flex items-center gap-1.5 text-[18px] text-gray-500 hover:text-gray-900 transition-colors"
              >
                다음
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            )}
          </div>
        </>
      )}
    </div>
  </main>

  <Footer />
</Layout>
