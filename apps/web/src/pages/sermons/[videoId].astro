---
export const prerender = false;

import { YOUTUBE_API_KEY } from 'astro:env/server';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const { videoId } = Astro.params;

const res = await fetch(
  `https://www.googleapis.com/youtube/v3/videos?part=snippet&id=${videoId}&key=${YOUTUBE_API_KEY}`
);
const { items } = await res.json();
const video = items?.[0];

if (!video) {
  return Astro.redirect('/sermons');
}

const title = video.snippet.title as string;
const publishedAt = video.snippet.publishedAt as string;
const date = new Date(publishedAt).toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const fromToken = Astro.url.searchParams.get('from');
const type = Astro.url.searchParams.get('type');

const pageLabel = type === 'testimony' ? '간증' : '주일 예배';
const backBase = type === 'testimony' ? '/sermons/testimony' : '/sermons';
const backHref = fromToken ? `${backBase}?pageToken=${encodeURIComponent(fromToken)}` : backBase;
---

<Layout title={`${title} | 시애틀 참빛교회`} description={`${title} — 시애틀 참빛교회 설교 영상입니다.`}>
  <Navbar />

  <main class="bg-white flex-1 pt-20">
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-24 xl:py-32">

      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 pb-2 mb-10">
        <span class="px-1 -mx-1 bg-[linear-gradient(transparent_62%,rgba(240,194,45,0.35)_62%)]">
          {pageLabel}
        </span>
      </h1>

      <div>
        <h2 class="text-xl md:text-2xl font-bold text-gray-900 leading-snug mb-2">
          {title}
        </h2>
        <p class="flex items-center gap-1.5 text-sm text-gray-500 mb-8">
          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <rect x="3" y="4" width="18" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 2v4M8 2v4M3 10h18" />
          </svg>
          {date}
        </p>

        <div class="aspect-video w-full">
          <iframe
            src={`https://www.youtube.com/embed/${videoId}`}
            title={title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="w-full h-full"
          />
        </div>

        <a
          href={backHref}
          class="inline-flex items-center gap-1.5 text-[18px] text-gray-500 hover:text-gray-900 transition-colors mt-16"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          {pageLabel} 목록
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
