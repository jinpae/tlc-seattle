---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="설교 | 시애틀 참빛교회" description="시애틀 참빛교회 설교 페이지입니다. 주일 예배와 새벽 예배 영상을 통해 하나님의 말씀을 나눕니다.">
  <Navbar />

<main class="bg-white flex-1 pt-20">
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-24 xl:py-32">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 pb-2 mb-10">
        <span class="px-1 -mx-1 bg-[linear-gradient(transparent_62%,rgba(240,194,45,0.35)_62%)]">
          설교
        </span>
      </h1>

      <div
        id="sermons-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5"
      >
        {Array.from({ length: 12 }).map(() => (
          <div class="bg-gray-50 overflow-hidden border border-gray-200 animate-pulse">
            <div class="aspect-video bg-gray-200" />
            <div class="sermon-card-skeleton-body">
              <div class="sermon-card-skeleton-title-a" />
              <div class="sermon-card-skeleton-title-b" />
              <div class="sermon-card-skeleton-date" />
            </div>
          </div>
        ))}
      </div>

      <!-- Desktop pagination -->
      <div class="hidden md:block">
        <div id="pagination-placeholder" class="mt-10 flex justify-end">
          <span class="inline-flex items-center gap-1.5 text-[18px] text-gray-300 select-none">
            다음
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </div>
        <div id="pagination" class="hidden mt-10 items-center justify-end gap-6">
          <button
            id="prev-btn"
            class="hidden items-center gap-1.5 text-[18px] text-gray-500 hover:text-gray-900 transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            이전
          </button>
          <button
            id="next-btn"
            class="hidden items-center gap-1.5 text-[18px] text-gray-500 hover:text-gray-900 transition-colors cursor-pointer"
          >
            다음
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile load more -->
      <div class="md:hidden mt-10 flex justify-center">
        <button
          id="load-more-btn"
          class="hidden items-center gap-2 bg-gray-900 text-white font-semibold text-lg px-[28px] py-[14px] rounded-lg hover:bg-gray-700 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
          더 보기
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style is:global>
  .sermon-card-skeleton-body {
    /* match real card: flex: 1 0 96.5px */
    min-height: 96.5px;
    padding: 1rem;
  }
  .sermon-card-skeleton-title-a {
    height: 18px;
    border-radius: 3px;
    background: #d1d5db;
  }
  .sermon-card-skeleton-title-b {
    height: 18px;
    width: 65%;
    margin-top: 4px;
    border-radius: 3px;
    background: #d1d5db;
  }
  .sermon-card-skeleton-date {
    height: 18px;
    width: 45%;
    margin-top: 6px;
    border-radius: 3px;
    background: #e5e7eb;
  }
</style>

<script>
  let nextToken: string | null = null;
  let prevToken: string | null = null;
  let loading = false;
  let pendingBackNav = false;

  document.addEventListener('astro:before-swap', (e: any) => {
    if (e.to?.pathname === '/sermons' && e.from?.pathname?.startsWith('/sermons/')) {
      pendingBackNav = true;
    }
  });

  function preloadImages(urls: string[]): Promise<void> {
    const loads = Promise.all(urls.map(src => new Promise<void>(resolve => {
      const img = new Image();
      img.onload = () => resolve();
      img.onerror = () => resolve();
      img.src = src;
    })));
    return Promise.race([loads, new Promise<void>(resolve => setTimeout(resolve, 1000))]);
  }

  function cardHTML({ videoId, title, publishedAt, thumbnail, duration }: any, pageToken: string) {
    const date = new Date(publishedAt).toLocaleDateString('ko-KR', {
      year: 'numeric', month: 'long', day: 'numeric',
    });
    const from = pageToken ? `?from=${encodeURIComponent(pageToken)}` : '';
    return `
      <a href="/sermons/${videoId}${from}" class="sermon-card-sm group bg-white overflow-hidden">
        <div class="relative aspect-video overflow-hidden">
          <img
            src="${thumbnail}"
            alt="${title.replace(/"/g, '&quot;')}"
            class="w-full h-full object-cover"
            loading="lazy"
          />
          ${duration ? `<span class="absolute bottom-2 right-2 bg-black/80 text-white text-xs font-medium px-1.5 py-0.5 rounded">${duration}</span>` : ''}
        </div>
        <div class="sermon-card-sm-body">
          <h3 class="sermon-card-sm-title">${title}</h3>
          <p class="sermon-card-sm-date">
            <svg width="14" height="14" style="flex-shrink:0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 2v4M8 2v4M3 10h18" />
            </svg>
            ${date}
          </p>
        </div>
      </a>`;
  }

  async function loadPage(pageToken: string, append = false) {
    if (loading) return;
    loading = true;
    const grid = document.getElementById('sermons-grid');
    const pagination = document.getElementById('pagination');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const loadMoreBtn = document.getElementById('load-more-btn') as HTMLButtonElement | null;
    if (!grid || !pagination || !prevBtn || !nextBtn) { loading = false; return; }

    if (append && loadMoreBtn) {
      loadMoreBtn.disabled = true;
      loadMoreBtn.innerHTML = `더 보기 <svg class="w-4 h-4 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 12a8 8 0 018-8V4" /></svg>`;
    }

    try {
      const url = new URL('/api/sermons.json', window.location.origin);
      url.searchParams.set('maxResults', '12');
      if (pageToken) url.searchParams.set('pageToken', pageToken);

      const res = await fetch(url.toString());
      if (!res.ok) throw new Error(res.status.toString());
      const data = await res.json();

      nextToken = data.nextPageToken;
      prevToken = data.prevPageToken;

      await preloadImages(data.sermons.map((s: any) => s.thumbnail));
      const cards = data.sermons.map((s: any) => cardHTML(s, pageToken)).join('');
      if (append) {
        grid.insertAdjacentHTML('beforeend', cards);
      } else {
        grid.innerHTML = cards;
      }

      document.getElementById('pagination-placeholder')?.remove();
      pagination.classList.remove('hidden');
      pagination.classList.add('flex');

      if (prevToken) {
        prevBtn.classList.remove('hidden');
        prevBtn.classList.add('inline-flex');
      } else {
        prevBtn.classList.add('hidden');
        prevBtn.classList.remove('inline-flex');
      }

      if (nextToken) {
        nextBtn.classList.remove('hidden');
        nextBtn.classList.add('inline-flex');
        loadMoreBtn?.classList.remove('hidden');
        loadMoreBtn?.classList.add('inline-flex');
      } else {
        nextBtn.classList.add('hidden');
        nextBtn.classList.remove('inline-flex');
        loadMoreBtn?.classList.add('hidden');
        loadMoreBtn?.classList.remove('inline-flex');
      }
    } catch {
      if (!append) {
        grid.innerHTML = '<p class="col-span-full text-center text-gray-400 py-12">설교를 불러오지 못했습니다.</p>';
      }
    } finally {
      loading = false;
      if (append && loadMoreBtn) {
        loadMoreBtn.disabled = false;
        loadMoreBtn.innerHTML = `더 보기 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>`;
      }
    }
  }

  function init() {
    if (!document.getElementById('sermons-grid')) return;

    const isMobile = window.innerWidth < 768;
    const savedHtml = sessionStorage.getItem('sermons-html');
    const isBack = pendingBackNav;
    pendingBackNav = false;
    if (isBack && savedHtml && isMobile) {
      const grid = document.getElementById('sermons-grid');
      const pagination = document.getElementById('pagination');
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      const loadMoreBtn = document.getElementById('load-more-btn');

      if (grid) grid.innerHTML = savedHtml;
      document.getElementById('pagination-placeholder')?.remove();

      nextToken = sessionStorage.getItem('sermons-next-token') || null;
      prevToken = sessionStorage.getItem('sermons-prev-token') || null;

      if (pagination) {
        pagination.classList.remove('hidden');
        pagination.classList.add('flex');
      }
      if (prevToken && prevBtn) {
        prevBtn.classList.remove('hidden');
        prevBtn.classList.add('inline-flex');
      }
      if (nextToken) {
        nextBtn?.classList.remove('hidden');
        nextBtn?.classList.add('inline-flex');
        loadMoreBtn?.classList.remove('hidden');
        loadMoreBtn?.classList.add('inline-flex');
      }

      const savedScroll = sessionStorage.getItem('sermons-scroll');
      if (savedScroll) {
        requestAnimationFrame(() => window.scrollTo({ top: parseInt(savedScroll) }));
      }

      sessionStorage.removeItem('sermons-html');
      sessionStorage.removeItem('sermons-scroll');
      sessionStorage.removeItem('sermons-next-token');
      sessionStorage.removeItem('sermons-prev-token');
    } else {
      sessionStorage.removeItem('sermons-html');
      sessionStorage.removeItem('sermons-scroll');
      sessionStorage.removeItem('sermons-next-token');
      sessionStorage.removeItem('sermons-prev-token');
      const pageToken = new URLSearchParams(window.location.search).get('pageToken') ?? '';
      loadPage(pageToken);
    }

    document.getElementById('sermons-grid')?.addEventListener('click', (e) => {
      const link = (e.target as Element).closest('a');
      if (!link) return;
      const grid = document.getElementById('sermons-grid');
      if (grid) sessionStorage.setItem('sermons-html', grid.innerHTML);
      sessionStorage.setItem('sermons-scroll', String(window.scrollY));
      if (nextToken) sessionStorage.setItem('sermons-next-token', nextToken);
      if (prevToken) sessionStorage.setItem('sermons-prev-token', prevToken);
    });

    document.getElementById('prev-btn')?.addEventListener('click', () => {
      if (!prevToken) return;
      const params = new URLSearchParams(window.location.search);
      params.set('pageToken', prevToken);
      history.pushState({}, '', `?${params}`);
      loadPage(prevToken);
      window.scrollTo({ top: 0 });
    });

    document.getElementById('next-btn')?.addEventListener('click', () => {
      if (!nextToken) return;
      const params = new URLSearchParams(window.location.search);
      params.set('pageToken', nextToken);
      history.pushState({}, '', `?${params}`);
      loadPage(nextToken);
      window.scrollTo({ top: 0 });
    });

    document.getElementById('load-more-btn')?.addEventListener('click', () => {
      if (!nextToken) return;
      loadPage(nextToken, true);
    });
  }

  document.addEventListener('astro:page-load', init);
  init();
</script>
