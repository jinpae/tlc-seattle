---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { client } from '../lib/sanity';

const rows: { name: string; time: string; place?: string; detail?: string }[] =
  await client.fetch(
    `*[_type == "gathering"] | order(orderRank asc) { name, time, place, detail }`
  );
---

<Layout title="예배 및 모임 | 시애틀 참빛교회" description="시애틀 참빛교회의 예배 및 다양한 모임 일정을 확인하실 수 있습니다.">
  <Navbar />

  <main class="bg-white flex-1 pt-20">
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-24 xl:py-32">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 pb-2 mb-10">
        <span class="px-1 -mx-1 bg-[linear-gradient(transparent_62%,rgba(240,194,45,0.35)_62%)]">
          예배 & 모임 안내
        </span>
      </h1>

      <div>
        <table class="w-full text-left border-collapse text-[17px] md:text-[20px]">
          <thead>
            <tr class="border-b-2 border-gray-900">
              <th class="pb-4 pr-6 md:pr-12 font-bold text-gray-900 md:whitespace-nowrap">예배 / 모임</th>
              <th class="pb-4 pr-6 md:pr-12 font-bold text-gray-900 md:whitespace-nowrap">시간</th>
              <th class="pb-4 pr-6 md:pr-12 font-bold text-gray-900 md:whitespace-nowrap">장소</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => (
              <Fragment>
                <tr class={`border-b border-gray-200${row.detail ? ' cursor-pointer hover:bg-gray-50' : ''}`} data-toggle={row.detail ? '' : undefined} data-index={i} aria-controls={`detail-${i}`}>
                  <td class="py-4 md:py-6 pr-6 md:pr-12 text-gray-900 md:whitespace-nowrap">
                    <button
                      class="flex items-center gap-2 font-medium text-left pointer-events-none"
                      aria-expanded={row.detail ? 'false' : undefined}
                      aria-controls={`detail-${i}`}
                    >
                      {row.detail && (
                        <svg
                          class="w-4 h-4 shrink-0 text-gray-400 transition-transform duration-200"
                          data-chevron
                          fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 18l6-6-6-6" />
                        </svg>
                      )}
                      {row.name}
                    </button>
                  </td>
                  <td class="py-4 md:py-6 pr-6 md:pr-12 text-gray-600 md:whitespace-nowrap">{row.time}</td>
                  <td class="py-4 md:py-6 pr-6 md:pr-12 text-gray-600 md:whitespace-nowrap">{row.place}</td>
                </tr>
                {row.detail && (
                  <tr id={`detail-${i}`} class="hidden border-b border-gray-200">
                    <td colspan="3" class="px-6 md:px-8 py-4 md:py-5 font-serif text-[16px] md:text-[18px] text-gray-600 leading-relaxed">
                      {row.detail}
                    </td>
                  </tr>
                )}
              </Fragment>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  function initAccordions() {
    document.querySelectorAll('tr[data-toggle]').forEach(row => {
      if (row.dataset.accordionInit) return;
      row.dataset.accordionInit = '1';
      row.addEventListener('click', () => {
        const btn = row.querySelector('button');
        const expanded = btn?.getAttribute('aria-expanded') === 'true';
        const detailRow = document.getElementById(row.getAttribute('aria-controls'));
        const chevron = row.querySelector('[data-chevron]');

        btn?.setAttribute('aria-expanded', String(!expanded));
        detailRow?.classList.toggle('hidden', expanded);
        chevron?.classList.toggle('rotate-90', !expanded);
        row.classList.toggle('border-b', expanded);
      });
    });
  }

  document.addEventListener('astro:page-load', initAccordions);
</script>
